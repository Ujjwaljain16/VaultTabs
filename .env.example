# Root environment for docker compose (copy to .env - never commit .env)
#
#   cp .env.example .env

# ─── Required ──────────────────────────────────────────────────────────────────

# Database password for the bundled Postgres container. Use a long random value.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# Secret used to sign login tokens (JWT). At least 32 characters; treat it like a password.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Token lifetime (default 30d)
# JWT_EXPIRY=30d

# Comma-separated browser origins allowed by CORS. Add your extension origin, e.g.
# chrome-extension://<extension-id>, and your PWA's public URL.
# ALLOWED_ORIGINS=http://localhost:3001

# Public URL of the backend API AS SEEN FROM THE USER'S BROWSER. Baked into the PWA at build time
# (rebuild the pwa image after changing it). Use https:// for anything but localhost.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Set to true only when the backend runs behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=false
