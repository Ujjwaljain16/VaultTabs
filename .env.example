# Root environment for docker compose (copy to .env - never commit .env)
#
#   cp .env.example .env
#
# The backend container reads these through docker-compose.yml. For running the backend without
# Docker, see backend/.env.example (same variable names, plus DATABASE_URL / DATABASE_SSL).

# ─── Required ──────────────────────────────────────────────────────────────────

# Database password for the bundled Postgres container. Use a long random value.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# Secret used to sign login tokens (JWT, HS256). At least 32 characters; placeholders are
# rejected at startup. Treat it like a password.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Token lifetime: <number><s|m|h|d|w> (default 30d). Tokens are additionally revoked server-side
# on password change, account recovery, "sign out everywhere" and account deletion.
# JWT_EXPIRY=30d

# Comma-separated browser origins allowed by CORS ("*" wildcards allowed). Add your PWA's public
# URL and your extension origin, e.g. chrome-extension://<extension-id>.
# ALLOWED_ORIGINS=http://localhost:3001

# Public URL of the backend API AS SEEN FROM THE USER'S BROWSER. Baked into the PWA at build time
# (rebuild the pwa image after changing it). Use https:// for anything but localhost.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# "true" only when the backend is reachable exclusively through a reverse proxy that sets
# X-Forwarded-For (rate limits are keyed on the client IP).
# TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Maximum registered browsers per account.
# MAX_DEVICES_PER_USER=25

# Minutes between in-process maintenance runs (0 disables).
# CLEANUP_INTERVAL_MINUTES=60

# Key for the fake KDF parameters / recovery material served for unknown emails (anti account
# enumeration). Derived from JWT_SECRET when empty; set it if you ever rotate JWT_SECRET.
# PRELOGIN_SECRET=
