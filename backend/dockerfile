# backend/dockerfile
#
# Build context is the REPO ROOT (see docker-compose.yml): the backend depends on the
# @vaulttabs/shared workspace package, which lives outside backend/.
#
#   docker build -f backend/dockerfile -t vaulttabs-backend .
#
# Stage 1 (builder): installs workspace deps, compiles shared + backend.
# Stage 2 (runner):  production deps + compiled output only, non-root.

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

# npm 10 has a workspace resolver bug with this lockfile; npm 11 is required.
RUN npm i -g npm@11

WORKDIR /build

# Workspace manifests first (better layer caching). All four are needed so npm can validate the
# root lockfile, even though only shared + backend are installed.
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY extension/package.json extension/
COPY pwa/package.json pwa/

RUN npm ci --ignore-scripts --workspace=shared --workspace=backend

COPY shared shared
COPY backend backend

RUN npm run build --workspace=shared && npm run build --workspace=backend

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

RUN npm i -g npm@11 && apk add --no-cache tini

ENV NODE_ENV=production

WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY extension/package.json extension/
COPY pwa/package.json pwa/

RUN npm ci --omit=dev --ignore-scripts --workspace=shared --workspace=backend \
  && npm cache clean --force

# shared/dist is needed at runtime (@vaulttabs/shared resolves to it).
COPY --from=builder /build/shared/dist shared/dist
COPY --from=builder /build/backend/dist backend/dist

WORKDIR /app/backend

# The official image ships an unprivileged "node" user (uid 1000).
USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/ready" > /dev/null || exit 1

# tini forwards SIGTERM so the server shuts down gracefully. Migrations run first (idempotent,
# serialized by an advisory lock if several replicas start at once).
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "node dist/db/migrate.js && exec node dist/server.js"]
