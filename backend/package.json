{
  "name": "vaulttabs-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VaultTabs backend API server",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "tsc -p ../shared/tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:cleanup": "tsx src/db/cleanup.ts",
    "test": "cd .. && vitest run --project backend",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.2.2",
    "@vaulttabs/shared": "*",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
