# VaultTabs backend configuration.
# Copy to backend/.env for local development (never commit .env). Variables already set in the
# environment always win over .env. Empty values count as unset.

# ─── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL=postgres://vaulttabs:password@localhost:5432/vaulttabs

# Secret that signs login tokens (HS256). At least 32 characters; placeholders are rejected.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Database ──────────────────────────────────────────────────────────────────

# TLS to Postgres:
#   require  (default) TLS with certificate verification - Neon, RDS, Railway, ...
#   insecure TLS WITHOUT certificate verification (self-signed only; MITM-able)
#   disable  no TLS (database on localhost or the same private/Docker network only)
DATABASE_SSL=require

# Connection pool size per process (default 10).
# DATABASE_POOL_MAX=10

# ─── Server ────────────────────────────────────────────────────────────────────

# development | production | test (default production). Development enables pretty logs and,
# when ALLOWED_ORIGINS is empty, allows any CORS origin.
NODE_ENV=development

# HOST=0.0.0.0
# PORT=3000

# fatal | error | warn | info | debug | trace | silent (default info)
# LOG_LEVEL=info

# Token lifetime: <number><s|m|h|d|w> (default 30d). Tokens are also revoked server-side on
# password change, recovery, "sign out everywhere" and account deletion.
# JWT_EXPIRY=30d

# Comma-separated browser origins allowed by CORS ("*" wildcards allowed, e.g.
# chrome-extension://*). Empty: any origin in development, none in production.
# Requests without an Origin header (extension background fetches, curl) are unaffected.
ALLOWED_ORIGINS=http://localhost:3001

# "true" ONLY when the backend is reachable exclusively through a reverse proxy that sets
# X-Forwarded-For (rate limits are keyed on the client IP). Default false.
# TRUST_PROXY=false

# Serve HTTPS directly (e.g. local development with mkcert). Set both or neither; in production
# terminate TLS at a reverse proxy / load balancer instead.
#   mkcert -cert-file certs/dev.pem -key-file certs/dev-key.pem localhost 192.168.1.10
# TLS_CERT_FILE=../certs/dev.pem
# TLS_KEY_FILE=../certs/dev-key.pem

# ─── Limits & maintenance ──────────────────────────────────────────────────────

# Maximum registered browsers per account (default 25).
# MAX_DEVICES_PER_USER=25

# In-process maintenance interval in minutes (default 60; 0 disables). Expires stale restore
# requests, enforces snapshot retention, removes long-idle empty devices. Safe with several
# instances (advisory lock). Run once by hand with: npm run db:cleanup
# CLEANUP_INTERVAL_MINUTES=60

# Key for the deterministic fake KDF salts / recovery material returned for unknown emails
# (prevents account enumeration). Optional: derived from JWT_SECRET when unset. Set it explicitly
# if you rotate JWT_SECRET, so fake answers do not change (which would reveal they are fake).
# PRELOGIN_SECRET=
