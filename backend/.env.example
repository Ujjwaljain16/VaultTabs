# Backend Environment Variables
# Copy to .env and fill in values (never commit .env)

# ─── Required ──────────────────────────────────────────────────────────────────

# Postgres connection (for Neon, append ?sslmode=require)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT secret, at least 32 characters (the server refuses to start with a shorter one or the
# placeholder). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Database TLS ──────────────────────────────────────────────────────────────

# require   (default) TLS with certificate verification - use for Neon, Railway, RDS, ...
# insecure  TLS without certificate verification (self-signed DBs only; MITM-able)
# disable   no TLS (only for a database on the same private/Docker network)
DATABASE_SSL=require

# ─── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed ORIGINS ("*" wildcards allowed). Enforced whenever set.
# If unset: development allows any origin, production allows none.
# Include your PWA URL and the chrome-extension:// origin
# Get extension ID from: chrome://extensions after loading the unpacked build
ALLOWED_ORIGINS=https://your-pwa.example.com,chrome-extension://YOUR_EXTENSION_ID_HERE

# ─── HTTPS ─────────────────────────────────────────────────────────────────────

# Set to "false" on Railway / Render / Fly.io / Docker where TLS terminates at a proxy
# Default (true): the server itself serves HTTPS using a local mkcert certificate found in /certs
# (generate one: cd certs && mkcert <your-ip-or-hostname>). Certificates are NOT in the repo.
HTTPS_ENABLED=false

# Your public IP/hostname (used to pick the right mkcert cert file in local dev)
# Leave empty on production
PUBLIC_IP=

# Set to "true" ONLY if running behind a reverse proxy that sets X-Forwarded-For
# (affects rate limiting, which is keyed on the client IP).
TRUST_PROXY=false

# ─── Optional ──────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Token lifetime (default 30d)
JWT_EXPIRY=30d
