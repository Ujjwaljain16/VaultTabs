# VaultTabs extension build configuration (copy to .env.local for dev or .env.production.local
# for release builds; never commit the real files). Values are baked in at BUILD time, so
# rebuild after changing them.

# Backend API base URL. Required for production builds (`npm run build`, `build:firefox`, `zip`),
# which fail if it is missing or uses plain http on a non-localhost host. The manifest requests
# host access to this origin only. In development it defaults to http://localhost:3000/api/v1.
VITE_API_URL=https://api.example.com/api/v1

# Optional: web dashboard (PWA) URL, shown as "Open web dashboard" in Settings.
VITE_DASHBOARD_URL=https://app.example.com

# Firefox add-on ID (browser_specific_settings.gecko.id). Use the ID registered on
# addons.mozilla.org; defaults to the placeholder vaulttabs@example.invalid.
VITE_FIREFOX_EXTENSION_ID=vaulttabs@example.com
