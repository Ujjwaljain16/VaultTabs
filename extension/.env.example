# Extension Environment Variables
# WXT uses Vite — these are injected at BUILD TIME.
#
# For local dev:  create .env.local
# For prod build: create .env.production.local
#
# IMPORTANT: After changing this, rebuild the extension with: npm run build
# The extension manifest only requests host access to localhost and the host in this URL
# (if it is unset the build falls back to any https:// host).
VITE_API_URL=https://your-backend.railway.app/api/v1
