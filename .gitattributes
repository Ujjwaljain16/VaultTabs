# Normalize line endings: LF in the repository and in working trees.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary

# Generated files: collapse in diffs
package-lock.json linguist-generated=true -diff
