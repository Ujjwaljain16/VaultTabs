# VaultTabs web dashboard (pwa/) — build-time configuration.
# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`: set them BEFORE building
# (docker: pass them as --build-arg). For local development copy this file to .env.local.

# Base URL of the VaultTabs API, reachable from the user's browser. Its origin is also added to the
# Content-Security-Policy connect-src. Use https in production.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Where the landing page "Download extension" button points.
NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL=https://github.com/Ujjwaljain16/VaultTabs/releases/latest

# Source repository (landing page links and the README security-model link).
NEXT_PUBLIC_REPO_URL=https://github.com/Ujjwaljain16/VaultTabs
