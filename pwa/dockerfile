# pwa/dockerfile — VaultTabs web dashboard
#
# Build context is the REPO ROOT (the dashboard depends on the @vaulttabs/shared workspace):
#   docker build -f pwa/dockerfile \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com/api/v1 -t vaulttabs-pwa .
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so they are build args.
# Uses Next.js standalone output; next.config.js traces from the repo root, so the server is
# at pwa/server.js inside the standalone bundle.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /build

# npm 10 has a workspace resolver bug with this lockfile.
RUN npm i -g npm@11

COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY extension/package.json extension/
COPY pwa/package.json pwa/

RUN npm ci --ignore-scripts --workspace=shared --workspace=pwa --include-workspace-root

COPY tsconfig.json ./
COPY shared shared
COPY pwa pwa

ARG NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
ARG NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL=https://github.com/Ujjwaljain16/VaultTabs/releases/latest
ARG NEXT_PUBLIC_REPO_URL=https://github.com/Ujjwaljain16/VaultTabs
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL=$NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL \
    NEXT_PUBLIC_REPO_URL=$NEXT_PUBLIC_REPO_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build --workspace=shared && npm run build --workspace=pwa

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S -u 1001 -G nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /build/pwa/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /build/pwa/.next/static ./pwa/.next/static
COPY --from=builder --chown=nextjs:nodejs /build/pwa/public ./pwa/public

USER nextjs
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/offline.html >/dev/null || exit 1

CMD ["node", "pwa/server.js"]
