{
  "name": "vaulttabs-pwa",
  "version": "1.0.5",
  "private": true,
  "description": "VaultTabs web dashboard (PWA): decrypts and restores your synced tabs locally",
  "license": "MIT",
  "scripts": {
    "prebuild": "tsc -p ../shared/tsconfig.json",
    "dev": "next dev -p 3001",
    "dev:https": "next dev -p 3001 --experimental-https",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vaulttabs/shared": "*",
    "idb": "^8.0.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
